# =============================================================================
# 배포 환경변수 샘플 — 이 파일을 .deploy.env 로 복사한 뒤 값을 채우세요.
#   cp .deploy.env.sample .deploy.env
# .deploy.env 는 .gitignore 에 포함되어 커밋되지 않습니다.
# =============================================================================

# ───────────────────────────────────────────────
# Firebase App Distribution
# ───────────────────────────────────────────────
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > Android 앱 ID
#   예) 1:1234567890:android:abcdef1234567890
FIREBASE_ANDROID_APP_ID=""

# 콤마(,)로 구분 — App Distribution > 그룹에서 생성한 그룹 별명
#   예) qa-team,beta-testers
FIREBASE_TESTER_GROUPS=""

# 콤마(,)로 구분 — 그룹 대신 개별 테스터 이메일 직접 지정 시
#   예) alice@example.com,bob@example.com
FIREBASE_TESTERS=""

# ───────────────────────────────────────────────
# Supabase
# ───────────────────────────────────────────────
# Supabase Dashboard > Project Settings > General > Reference ID
#   예) abcdefghijklmnop
SUPABASE_PROJECT_REF=""
